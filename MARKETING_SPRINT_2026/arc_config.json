  "kpis": {
    "targets": {
      "total_solicitudes": {
        "value": 150,
        "range": "100-200"
      },
      "approval_rate": {
        "value": 75,
        "unit": "%",
        "range": "70-80%"
      },
      "reviews_completed": {
        "value": 50,
        "unit": "%",
        "range": ">50% of approved"
      },
      "average_rating": {
        "value": 4.0,
        "unit": "stars",
        "range": "4.0+"
      },
      "sales_from_arcs": {
        "value": 10,
        "unit": "books",
        "tracking": "unique discount code"
      }
    }
  },
